# Copy to .env and fill in. Never commit .env.
#
#   cp env.example .env
#   chmod 600 .env
#
# .env must live in the project root (next to setup_env.sh) on the machine that runs
# the download -- i.e. on Torch, not just on your laptop. Override the location with
# ENV_FILE=/path/to/.env.
#
# Only setup_env.sh reads this. The scoring jobs run with HF_HUB_OFFLINE=1 against
# already-downloaded weights, so they never need a token.

# Hugging Face access token (https://huggingface.co/settings/tokens).
# OPTIONAL: Qwen3-Omni-30B-A3B-Instruct is a public model and downloads fine without
# one. A token only raises your rate limits, which helps on a ~70GB pull.
# A read-scoped token is sufficient.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
